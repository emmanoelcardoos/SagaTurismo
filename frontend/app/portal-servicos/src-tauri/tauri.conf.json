{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Portal SagaTurismo",
  "version": "0.2.0",
  "identifier": "br.com.sagatur.portal",
  "build": {
    "frontendDist": "https://turismo.saogeraldodoaraguaia.pa.gov.br/portal-servicos",
    "devUrl": "https://turismo.saogeraldodoaraguaia.pa.gov.br/portal-servicos",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Portal de Serviços - SagaTurismo",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}